#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

SERVICE_NAME="lx-manager"
APP_DIR="/usr/libexec/lx-manager"
NODE_BIN="/usr/bin/node"
CONFIG_SECTION="main"
APP_SOURCE_DIR="$APP_DIR/sources"
REQUIRED_NODE_MODULES="express axios https-proxy-agent node-cron"

EXTRA_COMMANDS="update"
EXTRA_HELP="    update        Run source update once"

load_lx_manager_config() {
	local section="${1:-$CONFIG_SECTION}"

	config_load "$SERVICE_NAME"

	config_get_bool enabled "$section" enabled 0
	config_get host "$section" host "0.0.0.0"
	config_get port "$section" port "4000"
	config_get source_base_dir "$section" source_base_dir "/etc/lx-manager/sources"
	config_get log_dir "$section" log_dir "/var/log/lx-manager"
	config_get proxy_url "$section" proxy_url ""
	config_get github_token "$section" github_token ""
	config_get max_days "$section" max_days "30"
	config_get search_limit "$section" search_limit "10"
	config_get max_commit_age_months "$section" max_commit_age_months "3"
	config_get url_select_window_ms "$section" url_select_window_ms "4000"
	config_get url_max_concurrent_requests "$section" url_max_concurrent_requests "3"
	config_get url_max_candidates "$section" url_max_candidates "6"
	config_get log_retention_days "$section" log_retention_days "7"
	config_get log_max_total_size_bytes "$section" log_max_total_size_bytes "52428800"
	config_get log_max_file_size_bytes "$section" log_max_file_size_bytes "10485760"
	config_get log_cleanup_interval_ms "$section" log_cleanup_interval_ms "21600000"
}

ensure_runtime_dirs() {
	mkdir -p "$source_base_dir" "$log_dir"
}

check_node_runtime() {
	[ -x "$NODE_BIN" ] || {
		echo "$SERVICE_NAME: missing Node.js runtime at $NODE_BIN" >&2
		return 1
	}

	"$NODE_BIN" -e "process.exit(Number(process.versions.node.split('.')[0]) >= 18 ? 0 : 1)" >/dev/null 2>&1 || {
		echo "$SERVICE_NAME: Node.js 18+ is required; current runtime is too old" >&2
		return 1
	}
}

check_node_modules() {
	[ -f "$APP_DIR/app.js" ] || {
		echo "$SERVICE_NAME: missing app entry at $APP_DIR/app.js" >&2
		return 1
	}

	local module
	for module in $REQUIRED_NODE_MODULES; do
		"$NODE_BIN" -e "require.resolve(process.argv[1], { paths: [process.argv[2]] })" "$module" "$APP_DIR" >/dev/null 2>&1 || {
			echo "$SERVICE_NAME: missing Node.js dependency '$module' under $APP_DIR/node_modules" >&2
			echo "$SERVICE_NAME: reinstall the package or rerun scripts/install-istoreos-local.sh after npm ci --omit=dev" >&2
			return 1
		}
	done
}

seed_runtime_sources() {
	[ -d "$APP_SOURCE_DIR" ] || return 0
	[ "$APP_SOURCE_DIR" = "$source_base_dir" ] && return 0

	local existing
	existing="$(find "$source_base_dir" -type f -name '*.js' 2>/dev/null | head -n 1 || true)"
	[ -n "$existing" ] && return 0

	echo "Seeding initial bundled sources into $source_base_dir"
	cp -R "$APP_SOURCE_DIR"/. "$source_base_dir"/
}

start_service() {
	load_lx_manager_config
	[ "$enabled" = "1" ] || return 0

	check_node_runtime || return 1
	check_node_modules || return 1
	ensure_runtime_dirs
	seed_runtime_sources

	procd_open_instance
	procd_set_param command "$NODE_BIN" "$APP_DIR/app.js"
	procd_set_param env \
		NODE_ENV=production \
		HOST="$host" \
		PORT="$port" \
		SOURCE_BASE_DIR="$source_base_dir" \
		LOG_DIR="$log_dir" \
		PROXY_URL="$proxy_url" \
		GITHUB_TOKEN="$github_token" \
		MAX_DAYS="$max_days" \
		SEARCH_LIMIT="$search_limit" \
		MAX_COMMIT_AGE_MONTHS="$max_commit_age_months" \
		URL_SELECT_WINDOW_MS="$url_select_window_ms" \
		URL_MAX_CONCURRENT_REQUESTS="$url_max_concurrent_requests" \
		URL_MAX_CANDIDATES="$url_max_candidates" \
		LOG_RETENTION_DAYS="$log_retention_days" \
		LOG_MAX_TOTAL_SIZE_BYTES="$log_max_total_size_bytes" \
		LOG_MAX_FILE_SIZE_BYTES="$log_max_file_size_bytes" \
		LOG_CLEANUP_INTERVAL_MS="$log_cleanup_interval_ms"
	procd_set_param file /etc/config/lx-manager
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="4096 4096"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$SERVICE_NAME"
}

update() {
	load_lx_manager_config
	check_node_runtime || return 1
	check_node_modules || return 1
	ensure_runtime_dirs
	seed_runtime_sources

	HOST="$host" \
	PORT="$port" \
	SOURCE_BASE_DIR="$source_base_dir" \
	LOG_DIR="$log_dir" \
	PROXY_URL="$proxy_url" \
	GITHUB_TOKEN="$github_token" \
	MAX_DAYS="$max_days" \
	SEARCH_LIMIT="$search_limit" \
	MAX_COMMIT_AGE_MONTHS="$max_commit_age_months" \
	URL_SELECT_WINDOW_MS="$url_select_window_ms" \
	URL_MAX_CONCURRENT_REQUESTS="$url_max_concurrent_requests" \
	URL_MAX_CANDIDATES="$url_max_candidates" \
	LOG_RETENTION_DAYS="$log_retention_days" \
	LOG_MAX_TOTAL_SIZE_BYTES="$log_max_total_size_bytes" \
	LOG_MAX_FILE_SIZE_BYTES="$log_max_file_size_bytes" \
	LOG_CLEANUP_INTERVAL_MS="$log_cleanup_interval_ms" \
	"$NODE_BIN" "$APP_DIR/updater.js"
}
