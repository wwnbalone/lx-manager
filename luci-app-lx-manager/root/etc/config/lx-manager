config main 'main'
	option enabled '0'
	option host '0.0.0.0'
	option port '4000'
	option source_base_dir '/etc/lx-manager/sources'
	option log_dir '/var/log/lx-manager'
	option proxy_url ''
	option github_token ''
	option max_days '30'
	option search_limit '10'
	option max_commit_age_months '3'
	option url_select_window_ms '4000'
	option url_max_concurrent_requests '3'
	option url_max_candidates '6'
	option log_retention_days '7'
	option log_max_total_size_bytes '52428800'
	option log_max_file_size_bytes '10485760'
	option log_cleanup_interval_ms '21600000'
