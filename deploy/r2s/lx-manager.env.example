# Copy to /etc/lx-manager.env before starting the service.
# Prefer storing sources and logs on external storage instead of router flash.

HOST=0.0.0.0
PORT=4000

# Update these paths to your mounted disk path on r2s.
SOURCE_BASE_DIR=/data/lx-manager/sources
LOG_DIR=/data/lx-manager/logs

# Optional outbound proxy for blocked upstream sources.
# Example: http://127.0.0.1:7890
PROXY_URL=

# Playback source selection window.
URL_SELECT_WINDOW_MS=4000
URL_MAX_CONCURRENT_REQUESTS=3
URL_MAX_CANDIDATES=6

# Log retention controls.
LOG_RETENTION_DAYS=7
LOG_MAX_TOTAL_SIZE_BYTES=52428800
LOG_MAX_FILE_SIZE_BYTES=10485760
LOG_CLEANUP_INTERVAL_MS=21600000
